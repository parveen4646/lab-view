# Copy to env.yaml, fill in real values, and pass to Cloud Run with:
#   gcloud run deploy lab-view-backend --source . --env-vars-file env.yaml ...
#
# A YAML file avoids gcloud's --set-env-vars comma-splitting, which breaks
# CORS_ORIGINS (a comma-separated list) if passed inline.
# env.yaml is gitignored — never commit it.

GOOGLE_OAUTH_CLIENT_ID: "xxxxx.apps.googleusercontent.com"
GROQ_API_KEY: "gsk_..."
GROQ_MODEL: "llama-3.3-70b-versatile"
GOOGLE_API_KEY: "AIza..."
ANTHROPIC_API_KEY: ""
DEEPSEEK_API_KEY: ""
CLAUDE_EXTRACTION_MODEL: "claude-haiku-4-5-20251001"
CLAUDE_QA_MODEL: "claude-sonnet-5"
GEMINI_MODEL: "gemini-3.8-flash"
DEEPSEEK_MODEL: "deepseek-chat"

QDRANT_URL: "https://xxxxx.cloud.qdrant.io"
QDRANT_API_KEY: ""
RAG_COLLECTION: "labview_kb"
RAG_RERANKER: "bge"
TYPESAFE_API_KEY: ""

SECRET_KEY: "generate-with-python -c 'import secrets; print(secrets.token_hex(32))'"
DEBUG: "False"
CORS_ORIGINS: "https://your-app.vercel.app"

DATABASE_URL: "postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require"
JWT_SECRET: ""
ACCESS_TOKEN_EXPIRE_MINUTES: "60"
