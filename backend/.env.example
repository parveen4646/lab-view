# Copy this file to .env and fill in your values.
# Never commit .env to git — add it to .gitignore.

# ── LLM Providers (fallback chain: Gemini → DeepSeek → Claude) ─────────────
# At least one key is required. The chain tries each in order on rate-limits.

# Google Sign-In — OAuth Client ID from Google Cloud Console (APIs & Services
# → Credentials → OAuth client ID → Web application). Different credential
# from GOOGLE_API_KEY below, which is for the Gemini LLM API, not login.
GOOGLE_OAUTH_CLIENT_ID=

# Groq — free tier, OpenAI-compatible, fast. Get a key at console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini (free tier via AI Studio — only free while its GCP project has
# no billing account linked; linking billing for anything else switches it to
# a paid prepay tier)
GOOGLE_API_KEY=AIza...

# DeepSeek V3 — very cheap paid fallback (~$0.27/M tokens)
DEEPSEEK_API_KEY=sk-...

# Anthropic Claude — last fallback (required if no other key is set)
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
CLAUDE_EXTRACTION_MODEL=claude-haiku-4-5-20251001
CLAUDE_QA_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-chat

# ── RAG (Q&A over lab reports + medical reference knowledge base) ──────────
# Free Qdrant Cloud cluster: https://cloud.qdrant.io — required for /api/qa/ask.
QDRANT_URL=https://xxxxx.cloud.qdrant.io
QDRANT_API_KEY=
RAG_COLLECTION=labview_kb

# Reranker: "bge" (local cross-encoder, default, no key needed) or "jev"
# (TypeSafe AI, experimental — needs TYPESAFE_API_KEY, get one at typesafe.ai)
RAG_RERANKER=bge
TYPESAFE_API_KEY=

# Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=False

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database — leave blank for local SQLite, set a postgresql:// URI in production
# (e.g. a free Neon/Supabase instance — required for Cloud Run, whose disk is ephemeral)
# SQLAlchemy 2 rejects the legacy "postgres://" prefix some providers still show you.
DATABASE_URL=

# JWT — defaults to SECRET_KEY if not set
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
