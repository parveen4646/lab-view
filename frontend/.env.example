# Copy to .env for local dev. In Vercel, set these as Project → Environment Variables
# instead — Vite bakes them in at build time, so changing them needs a redeploy.

# Your Cloud Run backend URL. Defaults to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# Neon Auth URL — copy from your Neon project → Settings → Auth → Auth URL.
# Google sign-in, email/password, and account management are all handled by Neon Auth.
VITE_NEON_AUTH_URL=https://ep-dawn-bird-b3aed6wb.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth

# Legacy: VITE_GOOGLE_CLIENT_ID is no longer needed — Google OAuth is now
# managed by Neon Auth. You can remove it from existing .env files.
