# Loaded automatically by Vite for production builds (vercel.json's
# buildCommand runs "npm run build", which defaults to production mode).
# Public URLs, safe to commit — not secrets.
VITE_API_URL=https://lab-view-backend-600036063697.us-central1.run.app

# Without this, src/lib/neon.ts falls back to an empty base URL and every
# sign-in/sign-up call silently goes nowhere — this was never set here, so
# Neon Auth never actually worked in production (it only worked in local
# dev, which reads this from .env instead).
VITE_NEON_AUTH_URL=https://ep-dawn-bird-b3aed6wb.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
